# ==========================================
# Backend Configuration Example
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=development
HOST=localhost
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB)
MONGO_URI= YOUR_MONGO_URI
MONGO_DB_NAME=astrial_shm

# Python ML Microservice Connection (FastAPI)
ML_BASE_URL=http://127.0.0.1:8000/ml/v1
ML_WS_URL=ws://127.0.0.1:8000/ml/v1/ws/stream
ML_TIMEOUT_MS=10000

# File Upload Settings
UPLOAD_MAX_MB=50
UPLOAD_DIR=./uploads

# Streaming & Real-Time Throttling
MAX_STREAM_FPS=5
STREAM_RECONNECT_INTERVAL_MS=3000

# Logging
LOG_LEVEL=info
